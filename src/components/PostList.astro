---
import { excerpt, formatDate, type Post } from '@/lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div>
  {
    posts.map((post) => (
      <div class="mb-6">
        <a href={`/${post.id}/`} class="group hover:no-underline">
          <h3 class="mb-2 group-hover:underline group-hover:underline-offset-2">{post.data.title}</h3>
        </a>
        <p class="text-[0.9rem] leading-normal text-muted">
          {formatDate(post.data.date)} - {excerpt(post.data.description)}
        </p>
      </div>
    ))
  }
</div>
